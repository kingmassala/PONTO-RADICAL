{
  "name": "ponto-radical",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:cms && npm run test:db",
    "test:cms": "node --conditions=react-server --import tsx tests/cms.test.ts",
    "test:db": "tsx tests/db.test.ts",
    "db:seed-sql": "node --conditions=react-server --import tsx scripts/generate-seed-sql.ts",
    "db:seed": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed.ts",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "backup": "node --env-file=.env.local scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "image-size": "^2.0.4",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
