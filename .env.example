# ---------------------------------------------------------------
# Ponto Radical — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure também na Vercel.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave pública (publishable / anon). Pode ser exposta no browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave secreta (secret / service_role). NUNCA a exponha no browser nem a
# coloque em variáveis NEXT_PUBLIC_. Usada apenas no servidor para gravar
# mensagens do formulário de contacto e convidar utilizadores.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Ligação directa à base de dados — só para `npm run db:migrate` (não é usada
# pelo website e NÃO deve ser configurada na Vercel).
# Supabase → Connect → Session pooler (substitua [YOUR-PASSWORD]).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Endereço público do website (sem barra no fim). Usado nos emails de
# recuperação de palavra-passe/convites, sitemap e robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: valor aleatório usado para anonimizar os IPs do formulário.
CONTACT_IP_SALT=troque-por-um-valor-aleatorio

# ---------------------------------------------------------------
# Gestão de Obras (/gestao ou gestao.<domínio>)
# ---------------------------------------------------------------
# Subdomínio da área de gestão (opcional; «gestao.*» já é reconhecido automaticamente).
NEXT_PUBLIC_GESTAO_HOST=gestao.pontoradical.com

# Segredo do agendador automático (/api/gestao/cron). Texto aleatório longo.
# Usado pela Vercel Cron e pelo Supabase pg_cron (cabeçalho Authorization: Bearer).
CRON_SECRET=troque-por-um-segredo-aleatorio-longo

# WhatsApp Business Platform (Cloud API oficial da Meta). Ver docs/GESTAO-WHATSAPP.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-aleatorio
# WHATSAPP_GRAPH_VERSION=v23.0
